# ExoMonad - track config and source, ignore runtime artifacts
.exo/*
!.exo/config.toml
!.exo/roles/
!.exo/lib/
!.exo/rules/

# Rust / Bevy - ignore build artifacts and debug files
splat_walk/target/
splat_walk/.rustc_info.json
splat_walk/Cargo.lock

# Chainlink - ignore local database and changelog
.chainlink/issues.db
.chainlink/
CHANGELOG.md

# Forgejo - ignore local runner configuration
.forgejo/runner.local.yml

# Codex - ignore local session state
.codex/

# Nested agent runtime state
splat_walk/.exo/

# Blender - ignore generated logs and backup saves
*.blend1

# Python - ignore local caches
__pycache__/
*.py[cod]

# Local generated databases
spindle.db*

# Local data and environment sandboxes
data/
splat_walk/assets/splats/*
!splat_walk/assets/splats/_template/
!splat_walk/assets/splats/corridor_straight/
!splat_walk/assets/splats/current_scene.txt
# environment/ is a local sandbox, but track the Meshroom acquisition doc (Stage M fallback).
environment/*
!environment/meshroom.md

# Archived Bevy effort (splat_walk + old plans) — 24G local backup, never commit.
archive/

# Godot per-machine import cache (also covered by godot_walk/.gitignore)
godot_walk/.godot/

# Nix build result symlinks
/result
/result-*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.git-remote/
dispatch-postmortem.md
session-export.json
assets/audio/
.claude/settings.local.json
.opencode/
opencode.json


build/
.env

# Pipeline build artifacts (per-scene working directories)
scripts/splat_pipeline/scenes/
