# Rust / Bevy - ignore build artifacts and debug files
splat_walk/target/
splat_walk/.rustc_info.json
splat_walk/Cargo.lock

# Chainlink - ignore local database and changelog
.chainlink/issues.db
.chainlink/
CHANGELOG.md

# Forgejo - ignore local runner configuration
.forgejo/runner.local.yml

# Codex - ignore local session state
.codex/

# Blender - ignore generated logs and backup saves
*.blend1

# Python - ignore local caches
__pycache__/
*.py[cod]

# Local generated databases
spindle.db*

# Local data and environment sandboxes
data/
splat_walk/assets/splats/*
!splat_walk/assets/splats/_template/
!splat_walk/assets/splats/corridor_straight/
!splat_walk/assets/splats/current_scene.txt
# environment/ is a local sandbox, but track the Meshroom acquisition doc (Stage M fallback).
environment/*
!environment/meshroom.md

# Archived Bevy effort (splat_walk + old plans) — 24G local backup, never commit.
archive/

# Godot per-machine import cache (also covered by godot_walk/.gitignore)
godot_walk/.godot/
godot_walk/generated_mesh_scenes/

# Nix build result symlinks
/result
/result-*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.git-remote/
dispatch-postmortem.md
session-export.json
assets/audio/
.claude/settings.local.json
build/
.env

# Pipeline build artifacts (per-scene working directories)
scripts/splat_pipeline/scenes/

# Generated capture fixtures. Regenerate deterministically with
#   python3 scripts/splat_pipeline/fixtures/make_capture_fixtures.py
# The generator, the fixture README and the recorded command outputs are tracked;
# the encoded clips are not (7 MB of H.264 that any machine with ffmpeg rebuilds
# byte-comparable from a fixed seed).
scripts/splat_pipeline/fixtures/clips/

# #147 Hunyuan visual GLB (307 MB). Pinned by SHA-256 in the issue's module_manifest.json;
# regenerate with the "Fresh Clone" steps in godot_walk/evidence/2026-10-20-issue-147/COMMANDS.md.
godot_walk/evidence/2026-10-20-issue-147/hunyuan_layers.glb

# Nerfstudio training outputs and exports (large, regeneratable from pipeline)
outputs/
exports/
splat_logs/

# Source-library runtime flock files (created by ingestion tools)
godot_walk/source_library/**/.*.lock
