{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/schemas/hunyuan-variant.schema.json",
  "title": "Hunyuan PSX variant proposal",
  "type": "object",
  "required": ["schema_version", "round_id", "variant_id", "parent_id", "hypothesis", "region_decisions", "authored_changes"],
  "properties": {
    "schema_version": {"const": 1},
    "round_id": {"type": "string", "pattern": "^hunyuan-psx-r[0-9]+$"},
    "variant_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "parent_id": {"type": ["string", "null"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "region_decisions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "provenance", "evidence", "reason"],
        "properties": {
          "id": {"type": "string"},
          "action": {"enum": ["preserve", "cover", "replace"]},
          "provenance": {"enum": ["source-observed", "hunyuan-generated", "authored", "inferred", "unknown"]},
          "evidence": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "authored_changes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "geometry", "material", "collision"],
        "properties": {
          "id": {"type": "string"},
          "geometry": {"type": "string"},
          "material": {"type": "string"},
          "collision": {"type": "string"}
        }
      }
    },
    "texture_provenance": {
      "type": "object",
      "required": ["source_frame", "source_frame_sha256", "crop_xyxy", "crop_method", "texture_path"],
      "properties": {
        "source_frame": {"type": "string", "minLength": 1},
        "source_frame_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "crop_xyxy": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "minItems": 4, "maxItems": 4},
        "crop_method": {"type": "string", "minLength": 1},
        "texture_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
