{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/godot_walk/room_catalog/shape_room.schema.json",
  "title": "Shape room (stage 0-3): deterministic generated room inside one generative-map cell",
  "type": "object",
  "required": [
    "schema_version", "generator_version", "map_id", "map_sha256", "cell_id", "role",
    "rarity_tier", "original_cell_status", "primitive", "primitive_class", "shape_stage",
    "construction", "arm_width_m", "envelope_xz", "arms_xz", "rects", "outline_xz", "area_m2",
    "ceiling_height_m", "doorways", "lamps_xz", "material_source", "materials", "features",
    "registration_accepted", "scale_calibrated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generator_version": { "enum": ["shape-room-0.1.0", "shape-room-0.2.0", "shape-room-0.3.0", "shape-room-0.4.0", "shape-room-0.5.0", "shape-room-0.6.0", "shape-room-0.7.0", "shape-room-0.8.0", "shape-room-0.9.0", "shape-room-0.10.0"] },
    "map_id": { "type": "string", "pattern": "^gmap-[0-9]+-.+$" },
    "map_sha256": { "$ref": "#/$defs/sha256" },
    "cell_id": { "type": "string", "minLength": 1 },
    "role": { "enum": ["ground", "figure", "threshold"] },
    "rarity_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "original_cell_status": { "type": "string", "minLength": 1 },
    "primitive": { "enum": ["dead_end", "straight", "l_shape", "t_shape", "cross", "u_shape"] },
    "primitive_class": { "enum": ["box", "l_shape", "rectilinear_polygon", "chamfered_box", "chamfered_polyomino", "octagon", "wedge", "diagonal_passage", "octagon_regular", "dodecagon", "rotunda16", "hexagon"] },
    "shape_stage": { "enum": [0, 1, 2, 3] },
    "construction": { "enum": ["box", "arms", "regular_polygon"] },
    "arm_width_m": { "type": ["number", "null"], "minimum": 3 },
    "envelope_xz": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/point_xz" } },
    "arms_xz": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
    "rects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rect" } },
    "outline_xz": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/point_xz" } },
    "area_m2": { "type": "number", "exclusiveMinimum": 0 },
    "ceiling_height_m": { "type": "number", "exclusiveMinimum": 2.1 },
    "floor_y": {
      "description": "gmap-0.10.0: absolute map floor level; the room itself stays local with floor at y = 0.",
      "type": "number"
    },
    "ramps": {
      "description": "gmap-0.10.0: ramps that descend inside this room from an upper doorway.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["port_id", "upper_cell_id", "start_xz", "direction_xz", "run_m", "rise_m", "width_m", "angle_deg"],
        "properties": {
          "port_id": {"type": "string", "minLength": 1},
          "upper_cell_id": {"type": "string", "minLength": 1},
          "start_xz": {"$ref": "#/$defs/point_xz"},
          "direction_xz": {"$ref": "#/$defs/point_xz"},
          "run_m": {"type": "number", "exclusiveMinimum": 0},
          "rise_m": {"type": "number", "exclusiveMinimum": 0},
          "width_m": {"type": "number", "exclusiveMinimum": 0},
          "angle_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 25.0}
        },
        "additionalProperties": false
      }
    },
    "doorways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["port_id", "pos_xz", "normal", "width_m", "height_m", "kind", "to_cell_id", "to_port_id"],
        "properties": {
          "port_id": { "type": "string", "minLength": 1 },
          "pos_xz": { "$ref": "#/$defs/point_xz" },
          "normal": { "$ref": "#/$defs/direction8" },
          "width_m": { "enum": [2.0, 2.4] },
          "sill_height_m": {"type": "number", "minimum": 0},
          "vertical": {"enum": ["ramp", "drop"]},
          "height_m": { "enum": [2.1, 2.2] },
          "compatibility_type": {
            "description": "Optional (shape-room-0.3.0). Selects the doorway size from the shared lookup table (scripts/doorway_sizes.py / .gd).",
            "enum": ["level_doorway_2m_v1", "authored_direct_doorway_2.4x2.2_v1"]
          },
          "kind": { "enum": ["open", "closed_visible"] },
          "to_cell_id": { "type": "string", "minLength": 1 },
          "to_port_id": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "lamps_xz": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/point_xz" } },
    "material_source": { "enum": ["kit_default", "palette_registry"], "description": "kit_default: shape-room-0.1.0-0.4.0. palette_registry: shape-room-0.5.0, materials resolved from the cell's palette." },
    "materials": {
      "oneOf": [
        {
          "title": "Kit default (shape-room-0.1.0 to 0.4.0)",
          "type": "object",
          "required": ["wallpaper_texture", "floor_texture", "ceiling_texture", "trim_color", "lamp_color"],
          "properties": {
            "wallpaper_texture": { "type": "string", "pattern": "^res://assets/psx_extension/textures/" },
            "floor_texture": { "type": "string", "pattern": "^res://assets/psx_extension/textures/" },
            "ceiling_texture": { "type": "string", "pattern": "^res://assets/psx_extension/textures/" },
            "trim_color": { "$ref": "#/$defs/rgb" },
            "lamp_color": { "$ref": "#/$defs/rgb" }
          },
          "additionalProperties": false
        },
        {
          "title": "Palette (shape-room-0.5.0)",
          "type": "object",
          "required": ["palette_id", "wall", "floor", "ceiling", "trim_color", "lamp_color"],
          "properties": {
            "palette_id": { "type": "string", "minLength": 1 },
            "wall": { "$ref": "#/$defs/surface" },
            "floor": { "$ref": "#/$defs/surface" },
            "ceiling": { "$ref": "#/$defs/surface" },
            "trim_color": { "$ref": "#/$defs/rgb" },
            "lamp_color": { "$ref": "#/$defs/rgb" },
            "registry_version": { "type": "string", "minLength": 1 },
            "wear": { "type": "integer", "minimum": 0, "maximum": 2 },
            "acoustic": {
              "type": "object",
              "required": ["wall", "floor", "ceiling", "trim"],
              "properties": {
                "wall": { "$ref": "#/$defs/acoustic" },
                "floor": { "$ref": "#/$defs/acoustic" },
                "ceiling": { "$ref": "#/$defs/acoustic" },
                "trim": { "$ref": "#/$defs/acoustic" }
              },
              "additionalProperties": false
            },
            "variants": {
              "type": "object",
              "required": ["wall", "floor", "ceiling", "trim"],
              "properties": {
                "wall": { "$ref": "#/$defs/variant_id" },
                "floor": { "$ref": "#/$defs/variant_id" },
                "ceiling": { "$ref": "#/$defs/variant_id" },
                "trim": { "$ref": "#/$defs/variant_id" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature_id", "kind", "sign"],
        "properties": {
          "feature_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["floor", "walls", "ceiling", "ceiling_lamp_grid", "ceiling_lamp_ring", "doorway", "diagonal_passage"] },
          "sign": { "const": "symbol" }
        },
        "additionalProperties": false
      }
    },
    "mode": {
      "description": "Optional (shape-room-0.2.0). The map cell's mode; degenerate rooms may carry corner doorways.",
      "enum": ["standard", "degenerate"]
    },
    "degenerate_features": {
      "description": "Optional (shape-room-0.2.0). Deliberate degenerate features of this room; empty for standard rooms.",
      "type": "array",
      "items": { "enum": ["corner_doorway"] },
      "uniqueItems": true
    },
    "degenerate_port_ids": {
      "description": "Optional (shape-room-0.2.0). Port ids whose doorway touches an envelope corner.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "chamfers": {
      "description": "Optional (shape-room-0.4.0, stage 2). Each convex corner of the un-cut outline replaced by a 45-degree chamfer of length_m along both legs; outline_xz is the cut outline and rects the inscribed raster rectangles.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["corner", "length_m"],
        "properties": {
          "corner": { "$ref": "#/$defs/point_xz" },
          "length_m": { "type": "number", "minimum": 1.0 }
        },
        "additionalProperties": false
      }
    },
    "registration_accepted": { "const": false },
    "scale_calibrated": { "const": false },
    "diagonal_passage": {
      "type": "object",
      "required": ["link_id", "clear_width_m", "length_m"],
      "properties": {
        "link_id": { "type": "string", "minLength": 1 },
        "clear_width_m": { "const": 2.0 },
        "length_m": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "landmark": {
      "type": "object",
      "required": ["class", "inradius_m", "circumradius_m", "rotation_deg", "port_facet_indices", "status"],
      "properties": {
        "class": {"enum": ["octagon_regular", "dodecagon", "rotunda16", "hexagon"]},
        "inradius_m": {"type": "number", "exclusiveMinimum": 0},
        "circumradius_m": {"type": "number", "exclusiveMinimum": 0},
        "rotation_deg": {"type": "number", "minimum": 0, "maximum": 360},
        "port_facet_indices": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "status": {"const": "placed"}
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "required": ["tier", "color_temp_k", "lamps"],
      "properties": {
        "tier": {"enum": ["dim", "normal", "bright"]},
        "color_temp_k": {"type": "integer", "minimum": 3800, "maximum": 5200},
        "lamps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lamp_index", "state", "flicker_seed"],
            "properties": {
              "lamp_index": {"type": "integer", "minimum": 0},
              "state": {"enum": ["on", "flicker", "dead"]},
              "flicker_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"if": {"properties": {"construction": {"const": "regular_polygon"}}, "required": ["construction"]}, "then": {"required": ["landmark"], "properties": {"shape_stage": {"const": 3}, "arms_xz": {"maxItems": 0}}}},
    {"if": {"properties": {"shape_stage": {"const": 3}}, "required": ["shape_stage"]}, "then": {"properties": {"construction": {"const": "regular_polygon"}}}},
    {"if": {"properties": {"generator_version": {"const": "shape-room-0.8.0"}}, "required": ["generator_version"]}, "then": {"required": ["light"]}},
    {"if": {"properties": {"generator_version": {"const": "shape-room-0.9.0"}}, "required": ["generator_version"]}, "then": {"required": ["light"], "properties": {"materials": {"required": ["registry_version", "wear", "acoustic", "variants"]}}}},
    {"if": {"properties": {"generator_version": {"const": "shape-room-0.10.0"}}, "required": ["generator_version"]}, "then": {"required": ["floor_y", "light"], "properties": {"materials": {"required": ["registry_version", "wear", "acoustic", "variants"]}}}},
    {"if": {"not": {"properties": {"construction": {"const": "regular_polygon"}}, "required": ["construction"]}}, "then": {"properties": {"arms_xz": {"minItems": 1}}}}
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "point_xz": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "direction8": {
      "oneOf": [
        { "enum": [[1, 0], [-1, 0], [0, 1], [0, -1]] },
        { "type": "array", "minItems": 2, "maxItems": 2, "items": { "enum": [0.7071067811865476, -0.7071067811865476] } }
      ]
    },
    "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
    "rgb": { "type": "array", "items": { "type": "number", "minimum": 0, "maximum": 1 }, "minItems": 3, "maxItems": 3 },
    "variant_id": { "enum": ["clean", "worn", "damaged"] },
    "acoustic": { "enum": ["carpet", "concrete", "tile", "plaster", "metal", "wood", "debris"] },
    "surface": {
      "description": "A palette surface: a texture tiled every tile_m metres, or a solid colour.",
      "oneOf": [
        {
          "type": "object",
          "required": ["texture", "tile_m"],
          "properties": {
            "texture": { "type": "string", "pattern": "^res://.+\\.png$" },
            "tile_m": { "type": "number", "exclusiveMinimum": 0 },
            "acoustic": { "$ref": "#/$defs/acoustic" },
            "variant": { "$ref": "#/$defs/variant_id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["color"],
          "properties": {
            "color": { "$ref": "#/$defs/rgb" },
            "acoustic": { "$ref": "#/$defs/acoustic" },
            "variant": { "$ref": "#/$defs/variant_id" }
          },
          "additionalProperties": false
        }
      ]
    },
    "index": {
      "title": "Shape-room index for one map and mode",
      "type": "object",
      "required": ["schema_version", "generator_version", "map_id", "map_file", "mode", "rooms"],
      "properties": {
        "schema_version": { "const": 1 },
        "generator_version": { "enum": ["shape-room-0.1.0", "shape-room-0.2.0", "shape-room-0.3.0", "shape-room-0.4.0", "shape-room-0.5.0", "shape-room-0.6.0", "shape-room-0.7.0", "shape-room-0.8.0", "shape-room-0.9.0", "shape-room-0.10.0"] },
        "map_id": { "type": "string", "pattern": "^gmap-[0-9]+-.+$" },
        "map_file": {
          "type": "object",
          "required": ["name", "sha256"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } },
          "additionalProperties": false
        },
        "mode": { "enum": ["pending", "all_walkable"] },
        "rooms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cell_id", "file", "sha256", "original_cell_status", "primitive", "primitive_class", "construction"],
            "properties": {
              "cell_id": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.json$" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "original_cell_status": { "type": "string", "minLength": 1 },
              "primitive": { "enum": ["dead_end", "straight", "l_shape", "t_shape", "cross", "u_shape"] },
              "primitive_class": { "enum": ["box", "l_shape", "rectilinear_polygon", "chamfered_box", "chamfered_polyomino", "octagon", "wedge", "diagonal_passage", "octagon_regular", "dodecagon", "rotunda16", "hexagon"] },
              "construction": { "enum": ["box", "arms", "regular_polygon"] },
              "mode": { "enum": ["standard", "degenerate"] },
              "palette_id": { "type": "string", "minLength": 1, "description": "Optional (shape-room-0.5.0). The room's material palette." }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
