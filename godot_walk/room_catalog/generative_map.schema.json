{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/godot_walk/room_catalog/generative_map.schema.json",
  "title": "Generative map (L0): lattice, cells, ports, roles and distribution",
  "type": "object",
  "required": [
    "schema_version", "map_id", "generator_version", "seed", "catalog_snapshot",
    "library_index", "lattice", "shape_stage_max", "cells", "edges",
    "distribution", "void_budget", "rules", "registration_accepted",
    "scale_calibrated"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "map_id": { "type": "string", "pattern": "^gmap-[0-9]+-.+$" },
    "generator_version": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "attempt": {
      "description": "Optional. Seed stream used by the generator (0 = the seed itself; n regenerates with stream n after a rule such as branch_required failed).",
      "type": "integer",
      "minimum": 0
    },
    "layout_variant": {
      "description": "Required by gmap-0.6.1. Deterministic site-aware layout search variant within the recorded attempt.",
      "type": "integer",
      "minimum": 0,
      "maximum": 47
    },
    "growth_cell_target": {"type": "integer", "minimum": 6, "maximum": 20},
    "landmark": { "$ref": "#/$defs/landmark_map" },
    "catalog_snapshot": { "$ref": "#/$defs/path_and_hash" },
    "library_index": { "$ref": "#/$defs/library_index" },
    "lattice": {
      "type": "object",
      "required": ["kind", "unit_m", "port_unit"],
      "properties": {
        "kind": { "const": "square" },
        "unit_m": { "type": "number", "exclusiveMinimum": 0 },
        "port_unit": { "type": "string", "minLength": 1 },
        "port_step_m": {
          "description": "Optional (gmap-0.2.0). Grid step for port positions when finer than unit_m; default: unit_m.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "shape_stage_max": { "type": "integer", "minimum": 0, "maximum": 5 },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cell_id", "envelope_xz", "ceiling_range_m", "allowed_primitives",
          "required_ports", "role", "rarity_tier"
        ],
        "properties": {
          "cell_id": { "type": "string", "minLength": 1 },
          "envelope_xz": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point_xz" } },
          "ceiling_range_m": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "allowed_primitives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "required_ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port_id", "pos_xz", "normal", "compatibility_type"],
              "properties": {
                "port_id": { "type": "string", "minLength": 1 },
                "pos_xz": { "$ref": "#/$defs/point_xz" },
                "normal": { "$ref": "#/$defs/direction8" },
                "compatibility_type": { "type": "string", "minLength": 1 },
                "placement": {
                  "description": "Optional (gmap-0.2.0), default standard. degenerate: the 2 m doorway touches an envelope corner (>= 1.5 m rule waived).",
                  "enum": ["standard", "degenerate"]
                }
              },
              "additionalProperties": false
            }
          },
          "role": { "enum": ["ground", "figure", "threshold", "void"] },
          "rarity_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
          "mode": {
            "description": "Optional (gmap-0.2.0), default standard. degenerate: may carry corner-hugging doorways (rare, budgeted).",
            "enum": ["standard", "degenerate"]
          },
          "shape_stage_target": {
            "description": "Optional (gmap-0.4.0). The shape stage drawn for this generated walkable cell (2: a stage-2 chamfered class, see shape_class_target).",
            "enum": [0, 1, 2, 3]
          },
          "shape_class_target": {
            "description": "Optional (gmap-0.4.0). The stage-2 primitive class drawn for this cell; present exactly when shape_stage_target is 2.",
            "enum": ["chamfered_box", "chamfered_polyomino", "octagon", "wedge", "diagonal_passage"]
          },
          "diagonal_link_chamfer": {
            "type": "object",
            "required": ["corner_xz", "length_m", "port_id"],
            "properties": {"corner_xz": {"$ref": "#/$defs/point_xz"}, "length_m": {"const": 2.5}, "port_id": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          },
          "landmark": { "$ref": "#/$defs/landmark_cell" },
          "diagonal_passage": {
            "type": "object",
            "required": ["link_id", "from_cell_id", "to_cell_id", "from_port_id", "to_port_id", "clear_width_m", "wall_thickness_m", "length_m", "outline_xz", "palette_source_cell_id"],
            "properties": {
              "link_id": {"type": "string", "minLength": 1}, "from_cell_id": {"type": "string", "minLength": 1},
              "to_cell_id": {"type": "string", "minLength": 1}, "from_port_id": {"type": "string", "minLength": 1},
              "to_port_id": {"type": "string", "minLength": 1}, "clear_width_m": {"const": 2.0},
              "wall_thickness_m": {"const": 0.16}, "length_m": {"type": "number", "exclusiveMinimum": 0},
              "outline_xz": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point_xz"}},
              "palette_source_cell_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "palette": {
            "description": "Optional (gmap-0.5.0). The material palette this generated walkable cell takes: the palette of the nearest placed library figure room (anchor_module_id, graph distance over open edges), or the registry default (both null). Module and void cells carry none.",
            "type": "object",
            "required": ["palette_id", "anchor_module_id", "distance"],
            "properties": {
              "palette_id": { "type": "string", "minLength": 1 },
              "anchor_module_id": { "type": ["string", "null"], "minLength": 1 },
              "distance": { "type": ["integer", "null"], "minimum": 1 }
            },
            "additionalProperties": false
          },
          "module": {
            "description": "Optional (gmap-0.3.0). The library module placed in this leaf cell: world = R(local) + translation_xz, R = rotation_deg / 90 quarter turns (x, z) -> (-z, x).",
            "type": "object",
            "required": ["module_id", "version", "rotation_deg", "translation_xz", "socket_id", "metadata_record"],
            "properties": {
              "module_id": { "type": "string", "minLength": 1 },
              "version": { "type": "integer", "minimum": 1 },
              "rotation_deg": { "enum": [0, 90, 180, 270] },
              "translation_xz": { "$ref": "#/$defs/point_xz" },
              "socket_id": { "type": "string", "minLength": 1 },
              "metadata_record": { "$ref": "#/$defs/path_and_hash" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "connector"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "connector": { "type": "string", "minLength": 1 },
          "connection_status": {
            "description": "Optional (gmap-0.3.0). proposed_untested: a new joint (generated cell to a library module's tested socket) that no operator has walked; it never inherits the #160 / #168 pair approval.",
            "enum": ["proposed_untested"]
          },
          "kind": {"enum": ["diagonal"]},
          "diagonal_link_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "object",
      "required": ["tier_curve", "repetition_budget"],
      "properties": {
        "tier_curve": { "type": "string", "minLength": 1 },
        "repetition_budget": {
          "type": "object",
          "required": ["max_same_module_adjacent", "max_same_primitive_run"],
          "properties": {
            "max_same_module_adjacent": { "type": "integer", "minimum": 0 },
            "max_same_primitive_run": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "void_budget": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "degenerate_budget": {
      "description": "Optional (required by gmap-0.2.0 rules). Rare degenerate cells: at most max, used so far.",
      "type": "object",
      "required": ["max", "used"],
      "properties": {
        "max": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "palette_registry": {
      "description": "Optional (required by gmap-0.5.0 rules). The material palette registry the cell palettes were assigned from, with its hash.",
      "$ref": "#/$defs/path_and_hash"
    },
    "diagonal_links": {
      "type": "object",
      "required": ["budget", "used", "selection_rule", "nudged_cells"],
      "properties": {
        "budget": {"type": "integer", "minimum": 0, "maximum": 2},
        "used": {"type": "integer", "minimum": 0, "maximum": 2},
        "selection_rule": {"type": "string", "minLength": 1},
        "nudged_cells": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reserved_diagonal_zones": {
          "description": "gmap-0.6.1 growth-time sites; realized entries become links and released entries remain unoccupied.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["site_id", "endpoint_ids", "corner_indices", "corner_xz", "start_xz", "finish_xz", "clearance_polygon_xz", "status"],
            "properties": {
              "site_id": {"type": "string", "pattern": "^ds[0-9]{2}$"},
              "endpoint_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
              "corner_indices": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
              "corner_xz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point_xz"}},
              "start_xz": {"$ref": "#/$defs/point_xz"},
              "finish_xz": {"$ref": "#/$defs/point_xz"},
              "clearance_polygon_xz": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point_xz"}},
              "status": {"enum": ["realized", "released"]},
              "link_id": {"type": "string", "minLength": 1},
              "release_reason": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {"if": {"properties": {"status": {"const": "realized"}}, "required": ["status"]}, "then": {"required": ["link_id"], "not": {"required": ["release_reason"]}}},
              {"if": {"properties": {"status": {"const": "released"}}, "required": ["status"]}, "then": {"required": ["release_reason"], "not": {"required": ["link_id"]}}}
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "module_budget": {
      "description": "Optional (required by gmap-0.3.0 rules). Library modules placed as leaf cells: min..max allowed, used so far.",
      "type": "object",
      "required": ["min", "max", "used"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "used": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "registration_accepted": { "const": false },
    "scale_calibrated": { "const": false }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"generator_version": {"const": "gmap-0.6.1"}}, "required": ["generator_version"]},
      "then": {
        "required": ["layout_variant"],
        "properties": {"diagonal_links": {"required": ["reserved_diagonal_zones"]}}
      }
    },
    {
      "if": {"properties": {"generator_version": {"const": "gmap-0.7.0"}}, "required": ["generator_version"]},
      "then": {
        "required": ["layout_variant", "growth_cell_target"],
        "properties": {"shape_stage_max": {"const": 3}}
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "landmark_cell": {
      "type": "object",
      "required": ["class", "inradius_m", "circumradius_m", "rotation_deg", "port_facet_indices", "status"],
      "properties": {
        "class": {"enum": ["octagon_regular", "dodecagon", "rotunda16", "hexagon"]},
        "inradius_m": {"type": "number", "exclusiveMinimum": 0},
        "circumradius_m": {"type": "number", "exclusiveMinimum": 0},
        "rotation_deg": {"type": "number", "minimum": 0, "maximum": 360},
        "port_facet_indices": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "status": {"const": "placed"}
      },
      "additionalProperties": false
    },
    "landmark_map": {
      "type": "object",
      "required": ["class", "inradius_m", "circumradius_m", "rotation_deg", "port_facet_indices", "status", "target_step"],
      "properties": {
        "class": {"enum": ["octagon_regular", "dodecagon", "rotunda16", "hexagon"]},
        "inradius_m": {"type": "number", "exclusiveMinimum": 0},
        "circumradius_m": {"type": "number", "exclusiveMinimum": 0},
        "rotation_deg": {"type": "number", "minimum": 0, "maximum": 360},
        "port_facet_indices": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "status": {"enum": ["placed", "unplaced"]},
        "target_step": {"type": "integer", "minimum": 1},
        "cell_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "placed"}}, "required": ["status"]}, "then": {"required": ["cell_id"], "not": {"required": ["reason"]}}},
        {"if": {"properties": {"status": {"const": "unplaced"}}, "required": ["status"]}, "then": {"required": ["reason"], "not": {"required": ["cell_id"]}}}
      ],
      "additionalProperties": false
    },
    "point_xz": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "path_and_hash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "library_index": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "metadata_records": {
          "description": "Optional (gmap-0.3.0). The poetics record read for each library module (accepted record, else the draft), sorted by module_id.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module_id", "path", "sha256"],
            "properties": {
              "module_id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "direction8": {
      "description": "Unit vector in one of eight directions: four cardinal, four diagonal (components +/-0.707107).",
      "oneOf": [
        { "enum": [[1, 0], [-1, 0], [0, 1], [0, -1]] },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "enum": [0.707107, -0.707107, 0.7071067811865476, -0.7071067811865476] }
        }
      ]
    }
  }
}
