{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material_palette.schema.json",
  "title": "Material palette registry (issue 192)",
  "description": "Hand-curated palettes that generated shape rooms take from nearby library figure rooms (gmap-0.5.0). Values are read from the library rooms' existing files; every field names where it came from.",
  "type": "object",
  "required": ["schema_version", "registry_version", "palettes"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_version": { "type": "string", "minLength": 1 },
    "palettes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/palette" } }
  },
  "additionalProperties": false,
  "$defs": {
    "rgb": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0, "maximum": 1 } },
    "provenance": {
      "type": "object",
      "required": ["from", "sign"],
      "properties": {
        "from": { "type": "string", "pattern": "^res://[^:]+::.+$", "description": "<res path>::<constant or material name> in that file" },
        "sign": { "enum": ["icon", "symbol"] }
      },
      "additionalProperties": false
    },
    "surface": {
      "description": "A wall, floor or ceiling: a texture (with its tile size in metres) or a solid colour.",
      "oneOf": [
        {
          "type": "object",
          "required": ["texture", "tile_m", "provenance"],
          "properties": {
            "texture": { "type": "string", "pattern": "^res://.+\\.png$" },
            "tile_m": { "type": "number", "exclusiveMinimum": 0 },
            "provenance": { "$ref": "#/$defs/provenance" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["color", "provenance"],
          "properties": { "color": { "$ref": "#/$defs/rgb" }, "provenance": { "$ref": "#/$defs/provenance" } },
          "additionalProperties": false
        }
      ]
    },
    "colour_field": {
      "type": "object",
      "required": ["color", "provenance"],
      "properties": { "color": { "$ref": "#/$defs/rgb" }, "provenance": { "$ref": "#/$defs/provenance" } },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["palette_id", "is_default", "match_style_tags", "source_module_ids", "wall", "floor", "ceiling", "trim_color", "lamp_color"],
      "properties": {
        "palette_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "is_default": { "type": "boolean" },
        "match_style_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "source_module_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "wall": { "$ref": "#/$defs/surface" },
        "floor": { "$ref": "#/$defs/surface" },
        "ceiling": { "$ref": "#/$defs/surface" },
        "trim_color": { "$ref": "#/$defs/colour_field" },
        "lamp_color": { "$ref": "#/$defs/colour_field" }
      },
      "additionalProperties": false
    }
  }
}
