{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/godot_walk/room_catalog/integration_proposal.schema.json",
  "title": "Library integration proposal (L3, append-only, operator decides)",
  "type": "object",
  "required": [
    "schema_version", "proposal_id", "source_id", "module", "targets",
    "catalog_snapshot_sha256", "library_index_sha256", "map_id", "cell_id",
    "placement", "sockets_used", "adapter_required", "work_required",
    "rationale", "assumptions", "unknowns", "evidence", "confidence",
    "outcome", "fit_result"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "pattern": "^video-[0-9a-f]{16}$" },
    "module": { "$ref": "#/$defs/module_ref" },
    "targets": { "type": "array", "items": { "$ref": "#/$defs/module_ref" } },
    "catalog_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "library_index_sha256": { "$ref": "#/$defs/sha256" },
    "map_id": { "type": ["string", "null"], "minLength": 1 },
    "cell_id": { "type": ["string", "null"], "minLength": 1 },
    "placement": {
      "type": ["object", "null"],
      "required": ["position_xz", "yaw_deg"],
      "properties": {
        "position_xz": { "$ref": "#/$defs/point_xz" },
        "yaw_deg": { "type": "number", "exclusiveMinimum": -360, "exclusiveMaximum": 360 }
      },
      "additionalProperties": false
    },
    "sockets_used": {
      "description": "Tested sockets joined by this proposal. Empty when an adapter is required or the outcome is not propose.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/socket_ref" },
          "to": { "$ref": "#/$defs/socket_ref" }
        },
        "additionalProperties": false
      }
    },
    "adapter_required": {
      "description": "Authored adapter geometry that would have to be added, or null. Never implied by video appearance.",
      "type": ["object", "null"],
      "required": ["description", "port_slot_ids"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "port_slot_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "work_required": {
      "type": "object",
      "required": ["clearance", "collision", "junction"],
      "properties": {
        "clearance": { "$ref": "#/$defs/text_list" },
        "collision": { "$ref": "#/$defs/text_list" },
        "junction": { "$ref": "#/$defs/text_list" }
      },
      "additionalProperties": false
    },
    "rationale": { "type": "string", "minLength": 1 },
    "assumptions": { "$ref": "#/$defs/text_list" },
    "unknowns": { "$ref": "#/$defs/text_list" },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "outcome": { "enum": ["propose", "keep_standalone", "abstain"] },
    "fit_result": {
      "type": "object",
      "required": ["footprint_fits", "ports_covered", "notes"],
      "properties": {
        "footprint_fits": { "type": ["boolean", "null"] },
        "ports_covered": { "type": ["boolean", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "propose" } }, "required": ["outcome"] },
      "then": {
        "required": ["placement"],
        "properties": { "placement": { "type": "object" } },
        "oneOf": [
          {
            "properties": {
              "sockets_used": { "minItems": 1 },
              "adapter_required": { "type": "null" }
            }
          },
          {
            "properties": {
              "sockets_used": { "maxItems": 0 },
              "adapter_required": { "type": "object" }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "point_xz": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "text_list": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "module_ref": {
      "type": "object",
      "required": ["module_id", "version"],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "socket_ref": {
      "type": "object",
      "required": ["module_id", "version", "socket_id"],
      "properties": {
        "module_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "socket_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
