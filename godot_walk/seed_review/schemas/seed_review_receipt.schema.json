{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed_review_receipt.schema.json",
  "title": "Append-only seed review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_spec_version",
    "stage",
    "status",
    "receipt_id",
    "input_fingerprint",
    "created_at_utc",
    "invocation_mode",
    "requires_operator_review",
    "next_stage_authorized",
    "source",
    "candidate_set",
    "model",
    "prompt",
    "request",
    "result",
    "usage",
    "guards",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "workflow_spec_version": { "const": "1.0.0" },
    "stage": { "const": "seed_review" },
    "status": {
      "enum": [
        "completed",
        "completed_low_confidence",
        "abstained",
        "timed_out",
        "provider_error",
        "invalid_response",
        "dry_run"
      ]
    },
    "receipt_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "invocation_mode": {
      "enum": ["live_model_call", "replayed_recorded_response", "dry_run"]
    },
    "requires_operator_review": { "type": "boolean" },
    "next_stage_authorized": { "const": false },
    "source": { "$ref": "#/$defs/source" },
    "candidate_set": { "$ref": "#/$defs/candidateSet" },
    "model": { "$ref": "#/$defs/model" },
    "prompt": { "$ref": "#/$defs/prompt" },
    "request": { "$ref": "#/$defs/request" },
    "result": { "$ref": "#/$defs/result" },
    "usage": { "$ref": "#/$defs/usage" },
    "guards": { "$ref": "#/$defs/guards" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "video_path",
        "video_sha256",
        "width",
        "height",
        "fps",
        "duration_seconds",
        "frame_count",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^video-[0-9a-f]{16}$"
        },
        "video_path": { "type": "string", "minLength": 1 },
        "video_sha256": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "frame_count": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "manifest_path": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_native_laplacian_variance",
        "focus_analysis_laplacian_variance",
        "exposure_mean_luminance",
        "exposure_clipped_low_fraction",
        "exposure_clipped_high_fraction",
        "exposure_score",
        "focus_score",
        "duplicate_similarity",
        "temporal_gap_seconds",
        "temporal_coverage_score",
        "mechanical_score",
        "mechanical_rank"
      ],
      "properties": {
        "focus_native_laplacian_variance": { "type": "number", "minimum": 0 },
        "focus_analysis_laplacian_variance": {
          "type": "number",
          "minimum": 0
        },
        "exposure_mean_luminance": { "type": "number" },
        "exposure_clipped_low_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exposure_clipped_high_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exposure_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "focus_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duplicate_similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporal_gap_seconds": { "type": "number", "minimum": 0 },
        "temporal_coverage_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mechanical_score": { "type": "number" },
        "mechanical_rank": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "index_zero_based",
        "pts_seconds",
        "path",
        "sha256",
        "width",
        "height",
        "origin",
        "decode_operation",
        "metrics"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^frame_[0-9]{4,}$"
        },
        "index_zero_based": { "type": "integer", "minimum": 0 },
        "pts_seconds": { "type": "number", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "origin": { "const": "direct_source_frame" },
        "decode_operation": {
          "const": "direct_source_video_decode_no_resize_or_edit"
        },
        "metrics": { "$ref": "#/$defs/metrics" }
      }
    },
    "excludedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "index_zero_based",
        "pts_seconds",
        "sha256",
        "mechanical_score",
        "mechanical_rank",
        "reason"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "pattern": "^frame_[0-9]{4,}$"
        },
        "index_zero_based": { "type": "integer", "minimum": 0 },
        "pts_seconds": { "type": "number", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/hash" },
        "mechanical_score": { "type": "number" },
        "mechanical_rank": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "candidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "provided_count",
        "reviewed_count",
        "mechanical_shortlist_applied",
        "candidates",
        "excluded"
      ],
      "properties": {
        "limit": { "const": 3 },
        "provided_count": { "type": "integer", "minimum": 1 },
        "reviewed_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "mechanical_shortlist_applied": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/reviewedCandidate" }
        },
        "excluded": {
          "type": "array",
          "items": { "$ref": "#/$defs/excludedCandidate" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reference",
        "image_input_supported",
        "image_input_support_basis",
        "is_free",
        "listed_price_usd",
        "accounting",
        "opencode_version"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "image_input_supported": { "type": "boolean" },
        "image_input_support_basis": {
          "type": "string",
          "minLength": 1
        },
        "is_free": { "type": "boolean" },
        "listed_price_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "accounting": { "type": "string", "minLength": 1 },
        "opencode_version": { "$ref": "#/$defs/nullableString" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "text", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "started_at_utc",
        "finished_at_utc",
        "elapsed_seconds",
        "command",
        "response_fixture_path",
        "response_fixture_sha256"
      ],
      "properties": {
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "started_at_utc": { "type": "string", "minLength": 1 },
        "finished_at_utc": { "type": "string", "minLength": 1 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "command": {
          "type": "array",
          "items": { "type": "string" }
        },
        "response_fixture_path": { "$ref": "#/$defs/nullableString" },
        "response_fixture_sha256": { "$ref": "#/$defs/nullableHash" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_status",
        "selected_frame_id",
        "selected_index_zero_based",
        "selected_pts_seconds",
        "selected_frame_sha256",
        "ranked_alternatives",
        "confidence_1_to_5",
        "confidence_threshold",
        "evidence",
        "uncertainty",
        "raw_response_sha256",
        "raw_response",
        "error"
      ],
      "properties": {
        "selection_status": {
          "enum": ["selected", "abstained", "not_available"]
        },
        "selected_frame_id": {
          "type": ["string", "null"],
          "pattern": "^frame_[0-9]{4,}$"
        },
        "selected_index_zero_based": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "selected_pts_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "selected_frame_sha256": { "$ref": "#/$defs/nullableHash" },
        "ranked_alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^frame_[0-9]{4,}$"
          }
        },
        "confidence_1_to_5": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 5
        },
        "confidence_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "evidence": { "$ref": "#/$defs/nullableString" },
        "uncertainty": { "$ref": "#/$defs/nullableString" },
        "raw_response_sha256": { "$ref": "#/$defs/nullableHash" },
        "raw_response": { "$ref": "#/$defs/nullableString" },
        "error": { "$ref": "#/$defs/nullableString" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reported",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "estimated_cost_usd",
        "actual_cost_usd",
        "listed_price_usd",
        "source"
      ],
      "properties": {
        "reported": { "type": "boolean" },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "estimated_cost_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "actual_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "listed_price_usd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "source": {
          "enum": [
            "provider_response",
            "recorded_fixture",
            "unavailable"
          ]
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_invoked",
        "paid_call_allowed",
        "hard_cost_ceiling_usd",
        "provider_enforces_spend_limit",
        "automatic_retry_allowed",
        "max_candidates",
        "timeout_within_limit",
        "registration_accepted",
        "scale_calibrated"
      ],
      "properties": {
        "model_invoked": { "type": "boolean" },
        "paid_call_allowed": { "type": "boolean" },
        "hard_cost_ceiling_usd": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "provider_enforces_spend_limit": { "type": "boolean" },
        "automatic_retry_allowed": { "const": false },
        "max_candidates": { "const": 3 },
        "timeout_within_limit": { "type": "boolean" },
        "registration_accepted": { "const": false },
        "scale_calibrated": { "const": false }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_spec_path",
        "workflow_spec_sha256",
        "request_schema_path",
        "request_schema_sha256",
        "response_schema_path",
        "response_schema_sha256",
        "receipt_schema_path",
        "receipt_schema_sha256",
        "request_path",
        "request_sha256"
      ],
      "properties": {
        "workflow_spec_path": { "type": "string", "minLength": 1 },
        "workflow_spec_sha256": { "$ref": "#/$defs/hash" },
        "request_schema_path": { "type": "string", "minLength": 1 },
        "request_schema_sha256": { "$ref": "#/$defs/hash" },
        "response_schema_path": { "type": "string", "minLength": 1 },
        "response_schema_sha256": { "$ref": "#/$defs/hash" },
        "receipt_schema_path": { "type": "string", "minLength": 1 },
        "receipt_schema_sha256": { "$ref": "#/$defs/hash" },
        "request_path": { "$ref": "#/$defs/nullableString" },
        "request_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
