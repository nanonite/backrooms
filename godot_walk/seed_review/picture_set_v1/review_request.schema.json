{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "picture-seed-review-request-v1",
  "title": "Picture-set seed-review request v1",
  "type": "object",
  "required": [
    "schema_version",
    "review_spec",
    "review_spec_version",
    "source_kind",
    "source_id",
    "source_image_set_sha256",
    "source_manifest_path",
    "source_manifest_sha256",
    "capture_index_semantics",
    "scoring",
    "model_review_limit",
    "candidate_count",
    "candidates",
    "excluded"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "review_spec": { "const": "picture_seed_review_v1" },
    "review_spec_version": { "const": "1.0.0" },
    "source_kind": { "const": "picture_set" },
    "source_id": { "type": "string", "pattern": "^picture-set-[0-9a-f]{16}$" },
    "source_image_set_sha256": { "$ref": "#/$defs/sha256" },
    "source_manifest_path": { "type": "string" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "capture_index_semantics": { "type": "string", "minLength": 1 },
    "scoring": {
      "type": "object",
      "required": ["metrics", "temporal_coverage_term", "score", "resolution_is_not_a_ranking_term"],
      "properties": {
        "metrics": { "const": ["focus", "exposure", "duplicate_similarity"] },
        "temporal_coverage_term": { "const": false },
        "score": { "type": "string" },
        "resolution_is_not_a_ranking_term": { "const": true }
      },
      "additionalProperties": false
    },
    "model_review_limit": { "const": 3 },
    "candidate_count": { "type": "integer", "minimum": 1, "maximum": 3 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "excluded": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate": {
      "type": "object",
      "required": [
        "image_id",
        "capture_index",
        "path",
        "sha256",
        "width",
        "height",
        "origin",
        "decode_operation",
        "resolution_warning",
        "resolution_warning_code",
        "metrics",
        "mechanical_rank"
      ],
      "properties": {
        "image_id": { "type": "string", "pattern": "^img_[0-9]{4,}$" },
        "capture_index": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "pattern": "^data/pictures/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "origin": { "const": "direct_source_picture" },
        "decode_operation": { "const": "direct_source_picture_bytes_no_resize_or_edit" },
        "resolution_warning": { "type": "boolean" },
        "resolution_warning_code": { "type": ["string", "null"] },
        "metrics": { "type": "object" },
        "mechanical_rank": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
