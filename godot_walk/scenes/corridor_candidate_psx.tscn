[gd_scene load_steps=12 format=3]

; PSX-scale presentation scene (#103 cleanup candidate).
;
; This scene is the #103 *cleanup candidate* presentation path. It renders
; corridor_candidate.ply (produced by scripts/splat_pipeline/clean_candidate.py
; from the #100 corridor_clean.ply; see corridor_candidate.report.json for the
; provenance check and per-stage counts) with the same PSX pass as
; corridor_psx.tscn. The two scenes differ only in the splat resource and the
; splat node's translation, so the fixed-view before/after captures of #103
; differ only by the cleanup itself. The #100 presentation path stays intact:
;   res://scenes/corridor_psx.tscn     (presentation, #100 cleanup, with PSX)
;   res://scenes/corridor.tscn         (walkable, source splat, no PSX)
;   res://scenes/corridor_splat.tscn   (inspection, source splat, no PSX)
;
; The world is NOT moved. The cleanup removes splats; the survivors keep their
; world positions. GDGS re-centres the loaded PLY at import (it subtracts the
; mean Gaussian centre), and the filtered mean differs from the source mean, so
; the splat node carries the report's `node_translation_world` on top of the
; contract basis. corridor_candidate.report.json records it and verifies the
; mapping; without it the room would shift ~1.64 m in Z.
;
; Collision, SafetyNet, spawn and player are byte-for-byte the accepted #85
; corridor.tscn values, so the traversal battery and the spawn contract are
; unchanged.

[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="1_player_scene"]
[ext_resource type="Script" path="res://addons/gdgs/runtime/nodes/gaussian_splat_node.gd" id="2_splat_script"]
[ext_resource type="Script" path="res://addons/gdgs/runtime/compositor/gaussian_compositor_effect.gd" id="3_compositor_script"]
[ext_resource type="Resource" path="res://assets/corridor_splat/corridor_candidate.ply" id="4_corridor_gaussian"]
[ext_resource type="Script" path="res://scripts/generated_collision.gd" id="5_generated_collision"]
[ext_resource type="Script" path="res://scripts/psx/psx_post_effect.gd" id="6_psx_effect"]

[sub_resource type="CompositorEffect" id="CompositorEffect_corridor"]
script = ExtResource("3_compositor_script")

[sub_resource type="CompositorEffect" id="CompositorEffect_psx"]
script = ExtResource("6_psx_effect")
pixel_size = 4
color_levels = 16
dither_strength = 1.0

[sub_resource type="Compositor" id="Compositor_corridor"]
compositor_effects = Array[CompositorEffect]([SubResource("CompositorEffect_corridor"), SubResource("CompositorEffect_psx")])

