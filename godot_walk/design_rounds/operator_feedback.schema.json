{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/schemas/hunyuan-operator-feedback.schema.json",
  "title": "Hunyuan PSX operator feedback",
  "type": "object",
  "required": ["schema_version", "round_id", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "round_id": {"type": "string", "pattern": "^hunyuan-psx-r[0-9]+$"},
    "status": {"enum": ["pending_operator_review", "confirmed"]},
    "reviewer_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "view_choices": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["view_id", "choice", "reason"],
        "properties": {
          "view_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "choice": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "variant_decisions": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "required": ["variant_id", "decision", "reason"],
        "properties": {
          "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "decision": {"enum": ["keep", "reject", "iterate"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "overall_walkthrough_notes": {"type": "string", "minLength": 1},
    "remaining_problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "description", "severity"],
        "properties": {
          "area": {"type": "string"},
          "description": {"type": "string"},
          "severity": {"type": "integer", "minimum": 1, "maximum": 3}
        }
      }
    },
    "next_round_directives": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "confirmed"}}},
      "then": {"required": ["reviewer_timestamp", "view_choices", "variant_decisions", "overall_walkthrough_notes", "remaining_problems", "next_round_directives", "confidence"]}
    }
  ]
}
