{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/schemas/hunyuan-track-record.schema.json",
  "title": "Hunyuan PSX workflow track record",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind",
    "issue",
    "round_id",
    "manifest_status",
    "variant_ids",
    "variant_specs",
    "provenance",
    "toolchain",
    "gate_results",
    "operator_feedback",
    "calibration",
    "evidence_paths",
    "skillopt_state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "hunyuan_design_round"},
    "issue": {"const": 151},
    "round_id": {"type": "string", "pattern": "^hunyuan-psx-r[0-9]+$"},
    "manifest_status": {"const": "operator_reviewed"},
    "variant_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "variant_specs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["variant_id", "parent_id", "hypothesis", "region_decisions", "authored_changes"],
        "properties": {
          "variant_id": {"type": "string"},
          "parent_id": {"type": "string"},
          "hypothesis": {"type": "string", "minLength": 1},
          "region_decisions": {"type": "array", "items": {"type": "object"}},
          "authored_changes": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_video", "seed_frame", "hunyuan_asset", "generation"],
      "properties": {
        "source_video": {"$ref": "#/$defs/asset"},
        "seed_frame": {"$ref": "#/$defs/asset"},
        "hunyuan_asset": {"$ref": "#/$defs/asset"},
        "generation": {"type": "object"}
      }
    },
    "toolchain": {
      "type": "object",
      "required": ["godot", "python", "odiff"],
      "properties": {
        "godot": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "odiff": {"type": "string", "minLength": 1}
      }
    },
    "gate_results": {
      "type": "object",
      "required": ["walkability", "negative_controls", "fps", "visual_metrics"],
      "properties": {
        "walkability": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["variant_id", "report_path", "failures", "route"],
            "properties": {
              "variant_id": {"type": "string"},
              "report_path": {"type": "string"},
              "failures": {"type": "array", "items": {"type": "string"}},
              "route": {
                "type": "object",
                "required": ["distance_m", "floor_fraction", "max_step_m", "safety_contacts"],
                "properties": {
                  "distance_m": {"type": "number", "minimum": 0},
                  "floor_fraction": {"type": "number", "minimum": 0, "maximum": 1},
                  "max_step_m": {"type": "number", "minimum": 0},
                  "safety_contacts": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        },
        "negative_controls": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["mutation", "path", "failed_closed"],
            "properties": {
              "mutation": {"type": "string"},
              "path": {"type": "string"},
              "failed_closed": {"type": "boolean"}
            }
          }
        },
        "fps": {
          "type": "object",
          "required": ["report_path", "capped_at_60", "fps", "p95_frame_ms", "p99_frame_ms"],
          "properties": {
            "report_path": {"type": "string"},
            "capped_at_60": {"type": "boolean"},
            "fps": {"type": "number", "minimum": 0},
            "p95_frame_ms": {"type": "number", "minimum": 0},
            "p99_frame_ms": {"type": "number", "minimum": 0}
          }
        },
        "visual_metrics": {
          "type": "object",
          "required": ["report_path", "odiff_threshold", "noise_rule", "measurements"],
          "properties": {
            "report_path": {"type": "string"},
            "odiff_threshold": {"type": "number", "minimum": 0},
            "noise_rule": {"type": "string", "minLength": 1},
            "measurements": {
              "type": "object",
              "required": ["round_id", "odiff_tool", "scope", "control_repeat_noise", "per_view_noise_ceiling_pct", "variant_pixel_deltas", "interpretation", "rule"],
              "properties": {
                "round_id": {"type": "string"},
                "odiff_tool": {"type": "string"},
                "scope": {"type": "string"},
                "control_repeat_noise": {"type": "array", "items": {"type": "object"}},
                "per_view_noise_ceiling_pct": {"type": "object"},
                "variant_pixel_deltas": {"type": "array", "items": {"type": "object"}},
                "interpretation": {"type": "string"},
                "rule": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "operator_feedback": {
      "type": "object",
      "required": ["path", "status", "view_choices", "variant_decisions", "overall_walkthrough_notes", "next_round_directives", "confidence"],
      "properties": {
        "path": {"type": "string"},
        "status": {"const": "confirmed"},
        "view_choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["view_id", "choice", "reason"],
            "properties": {
              "view_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "choice": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "variant_decisions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["variant_id", "decision", "reason"],
            "properties": {
              "variant_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "decision": {"enum": ["keep", "reject", "iterate"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "overall_walkthrough_notes": {"type": "string"},
        "next_round_directives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["directive_id", "text"],
            "properties": {
              "directive_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "calibration": {
      "type": "object",
      "required": ["registration_accepted", "scale_calibrated"],
      "properties": {
        "registration_accepted": {"const": false},
        "scale_calibrated": {"const": false}
      }
    },
    "evidence_paths": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "skillopt_state": {"const": "data_collection_only"}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {"type": "string"}
      }
    }
  }
}
