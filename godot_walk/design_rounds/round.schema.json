{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backrooms.local/schemas/psx-design-round.schema.json",
  "title": "PSX design round specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "round_id",
    "round_number",
    "out_dir",
    "issue",
    "baseline",
    "variants",
    "title",
    "scope",
    "review_prompt",
    "texture_crops",
    "repeat_count",
    "settle_frames",
    "resolution",
    "fov_degrees",
    "fixed_fps",
    "rendering_driver",
    "capture_path",
    "negative_controls",
    "additional_inputs",
    "route_drift",
    "feedback_template"
  ],
  "properties": {
    "round_id": { "type": "string", "pattern": "^round-[1-9][0-9]*$" },
    "round_number": { "type": "integer", "minimum": 1 },
    "out_dir": {
      "type": "string",
      "pattern": "^godot_walk/evidence/[A-Za-z0-9._-]+$"
    },
    "issue": { "type": "integer", "minimum": 1 },
    "baseline": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "review_prompt": { "type": "string", "minLength": 1 },
    "inherited_feedback": { "type": "string" },
    "texture_crops": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "prefixItems": [
          { "type": "integer", "minimum": 0 },
          { "type": "integer", "minimum": 0 },
          { "type": "integer", "minimum": 1 },
          { "type": "integer", "minimum": 1 }
        ],
        "items": false
      }
    },
    "video": { "type": "string", "minLength": 1 },
    "source_frame": { "type": "string", "minLength": 1 },
    "repeat_count": { "type": "integer", "minimum": 1, "maximum": 10 },
    "settle_frames": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false
    },
    "fov_degrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
    "fixed_fps": { "type": "integer", "minimum": 1, "maximum": 240 },
    "rendering_driver": { "const": "vulkan" },
    "capture_path": { "type": "string", "minLength": 1 },
    "negative_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["boundary", "floor"] }
    },
    "additional_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "route_drift": { "type": "boolean" },
    "feedback_template": { "type": "string" }
  }
}
